NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgres://store:development-only@127.0.0.1:5432/store
DB_POOL_MAX=10
DB_SSL=false
DB_CA_FILE=
# Set exact trusted proxy IPs/subnets for your Coolify network.
TRUST_PROXY=loopback
STORE_NAME=Store
STORE_ADDRESS=
STORE_EMAIL=
STORE_TAX_ID=
CURRENCY=USD
LANGUAGE=en
MULTI_CURRENCY=false
CURRENCY_RATES={}
MULTI_LANGUAGE=false
SHIPPING_FEE_MINOR=0
TAX_BPS=0
RETURN_WINDOW_DAYS=14
SESSION_DAYS=7
LOG_LEVEL=info
PAYMENT_PROVIDER=cod
# Stripe adapter is staged and blocked pending reconciliation tests.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SHIPPING_PROVIDER=manual
# Optional HTTPS adapter contract: docs/INTEGRATIONS.md
SHIPPING_API_URL=
SHIPPING_API_TOKEN=
SHIPPING_WEBHOOK_SECRET=
# ImageKit cloud media configuration
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_ID=
